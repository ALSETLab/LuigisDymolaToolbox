          T3=pss3_T3,
          T4=pss3_T4) annotation (Placement(transformation(extent={{-60,-28},{-40,-8}})));
        LuigisToolbox.CustomComponents.TimedInputInjectionOnOff t1_t2(t_start=
              t1, t_stop=t2)
          annotation (Placement(transformation(extent={{-20,58},{0,78}})));
        OpenIPSL.Electrical.Controls.PSAT.PSS.PSSTypeII pSS4(
          vsmax=pss4_vsmax,
          vsmin=pss4_vsmin,
          Kw=pss4_Kw,
          Tw=pss4_Tw,
