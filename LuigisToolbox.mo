        // stop defining parameters
        OpenIPSL.Electrical.Controls.PSAT.PSS.PSSTypeII pSS2(
          vsmax=pss2_vsmax,
          vsmin=pss2_vsmin,
          Kw=pss2_Kw,
          Tw=pss2_Tw,
          T1=pss2_T1,
          T2=pss2_T2,
          T3=pss2_T3,
